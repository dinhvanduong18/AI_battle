{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "admin:local": "node scripts/set-local-admin.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "OTTV2_SKIP_AUTOSTART=1 tsx --test server/test/*.test.js",
    "test:load": "node scripts/stress-test.mjs",
    "test:load:ws": "node scripts/stress-test.mjs --ws-only",
    "test:load:http": "node scripts/stress-test.mjs --http-only",
    "test:load:matchmaking": "npx k6 run loadtest-matchmaking.js",
    "test:load:stress": "npx k6 run loadtest-high-stress.js",
    "test:load:900": "npx k6 run loadtest-900-users.js",
    "test:load:escalating": "npx k6 run loadtest-escalating.js",
    "test:load:ultra": "npx k6 run loadtest-ultra-stress.js",
    "test:load:bots": "K6_WEB_DASHBOARD=true K6_WEB_DASHBOARD_PORT=5665 K6_WEB_DASHBOARD_EXPORT=k6-1000-bots-report.html npx k6 run loadtest-1000-bot-battle.js"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@rolldown/binding-linux-x64-gnu": "^1.2.15",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "peerjs": "^1.5.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
